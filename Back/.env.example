NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DB_TYPE=sqlite
# DB_PATH defaults to Back/data/kitchen.sqlite. Use an absolute path to override it.
# npm run setup generates random local secrets in Back/.env.
JWT_SECRET=replace-with-a-random-local-secret
REFRESH_TOKEN_SECRET=replace-with-another-random-local-secret
# Optional: SPOONACULAR_API_KEY=
